---
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import "@fontsource-variable/inter/index.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@/styles/global.css";
import { REPO, SITE, ORG, RELEASE } from "@/lib/data";
interface Crumb { name: string; path: string }
interface Props { title: string; description: string; path: string; jsonld?: object[]; crumbs?: Crumb[]; noindex?: boolean; ogType?: string }
const { title, description, path, jsonld = [], crumbs = [], noindex = false, ogType = "website" } = Astro.props;
const url = SITE + (path === "/" ? "/" : path);
const nav = [
  ["/", "Overview"], ["/results", "Results"], ["/analysis", "Findings"], ["/tasks", "Tasks"], ["/process", "Process track"], ["/methods", "Methods"],
  ["/paper", "Paper"], ["/reproduce", "Reproduce"], ["/audit", "Audit"], ["/roadmap", "Roadmap"],
];
const current = (p: string) => (path === p || (p !== "/" && path.startsWith(p + "/"))) ? "page" : undefined;
const breadcrumbLd = crumbs.length ? [{
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [{ name: "Business Bench", path: "/" }, ...crumbs].map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: SITE + (c.path === "/" ? "/" : c.path) })),
}] : [];
const ld = [...jsonld, ...breadcrumbLd];
const fullTitle = title === "Business Bench" ? "Business Bench: evaluating AI agents on business deliverables" : `${title} · Business Bench`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={url} />
<meta property="og:site_name" content="Business Bench" />
<meta property="og:title" content={title === "Business Bench" ? fullTitle : title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:type" content={ogType} />
<meta property="og:image" content={SITE + "/og.png"} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="color-scheme" content="only light" />
<meta name="theme-color" content="#ffffff" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/x-ndjson" href="https://raw.githubusercontent.com/erphq/business-bench/main/results/latest/attempts.jsonl" title="Attempt ledger" />
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body>
<a class="sr" href="#main">Skip to content</a>
<header class="site-head">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Business Bench home">
      <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="6" fill="currentColor"/><rect x="7" y="17" width="4" height="8" fill="var(--bg)"/><rect x="14" y="11" width="4" height="14" fill="var(--s1)"/><rect x="21" y="7" width="4" height="18" fill="var(--bg)"/></svg>
      Business Bench
    </a>
    <span class="site-description">A benchmark for AI agents on business work</span>
    <nav class="header-links" aria-label="Resources">
      <a href="/paper">Read the paper</a>
      <a href={REPO} rel="noopener">GitHub</a>
    </nav>
  </div>
</header>
<div class="wiki-layout wrap">
  <aside class="wiki-sidebar" aria-label="Site navigation and page contents">
    <details class="wiki-menu" open>
      <summary>Navigation and contents</summary>
      <div class="wiki-menu-body">
        <nav class="wiki-nav" aria-label="Primary">
          <span class="sidebar-heading">Explore</span>
          {nav.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
        </nav>
        <slot name="contents" />
      </div>
    </details>
  </aside>
  <main id="main" class="wiki-article" tabindex="-1">
    <slot />
  </main>
</div>
<script>
  const menu = document.querySelector<HTMLDetailsElement>(".wiki-menu");
  const desktop = window.matchMedia("(min-width: 901px)");
  const setMenuForViewport = () => { if (menu) menu.open = desktop.matches; };
  setMenuForViewport();
  desktop.addEventListener("change", setMenuForViewport);
</script>
<footer class="site-foot">
  <div class="wrap">
    <div>
      <h4>Business Bench</h4>
      <p>Public tasks and recorded evaluations of AI agents on business deliverables. Desk release <code>{RELEASE.id}</code>, version {RELEASE.version}.</p>
      <p>Published by <a href={ORG.url} rel="noopener">{ORG.name}</a>, which also develops Proto, one of the evaluated harnesses. The conflict is stated on every results page and assessed in the <a href="/audit">evidence audit</a>.</p>
    </div>
    <div>
      <h4>Read</h4>
      <ul>
        <li><a href="/paper">Paper</a> · <a href="/methods">Methods</a></li>
        <li><a href="/results">Desk results</a> · <a href="/analysis">Findings</a></li>
        <li><a href="/process">Process track (pilot)</a></li>
        <li><a href="/tasks">Task inventory</a></li>
        <li><a href="/audit">Evidence audit</a> · <a href="/roadmap">Roadmap</a></li>
      </ul>
    </div>
    <div>
      <h4>Data and code</h4>
      <ul>
        <li><a href={REPO} rel="noopener">erphq/business-bench</a> (MIT)</li>
        <li><a href={`${REPO}/blob/main/results/latest/attempts.jsonl`} rel="noopener">Attempt ledger</a>, every verdict</li>
        <li><a href="/reproduce">Reproduce a run</a></li>
        <li><a href={`${REPO}/issues`} rel="noopener">Report an error or dispute a task</a></li>
      </ul>
    </div>
  </div>
</footer>
</body>
</html>
