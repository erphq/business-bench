---
import Base from "@/layouts/Base.astro";
import { readRepoFile, REPO } from "@/lib/data";
import { renderMarkdown } from "@/lib/markdown";
const base = `${REPO}/blob/main/docs/v2/`;
// The three v2 documents render on one page; cross-links between them become anchors.
const rewire = (md: string) => md.replace(/\]\(tasks\.md\)/g, "](#the-100-tasks)").replace(/\]\(human-baseline\.md\)/g, "](#human-baseline-protocol)").replace(/\]\(README\.md\)/g, "](#specification)");
const spec = renderMarkdown(rewire(readRepoFile("docs/v2/README.md")), { stripFirstH1: true, linkBase: base });
const tasks = renderMarkdown(rewire(readRepoFile("docs/v2/tasks.md")), { stripFirstH1: true, linkBase: base });
const human = renderMarkdown(rewire(readRepoFile("docs/v2/human-baseline.md")), { stripFirstH1: true, linkBase: base });
const toc = [
  { depth: 2, id: "specification", text: "Specification" }, ...spec.toc.map((t) => ({ ...t, depth: 3 })),
  { depth: 2, id: "the-100-tasks", text: "The 100 tasks" }, ...tasks.toc.filter((t) => t.depth === 2).map((t) => ({ ...t, depth: 3 })),
  { depth: 2, id: "human-baseline-protocol", text: "Human baseline protocol" },
];
const desc = "Business Bench research plan: proposed capability axes, task designs, difficulty bands, evaluator review, held-out work and a human baseline. Distinguishes specifications from completed evidence.";
---
<Base title="Roadmap" description={desc} path="/roadmap">
  <p class="meta">Roadmap<span class="sep">·</span>desk track v2 research plan<span class="sep">·</span>proposals are not evaluation results<span class="sep">·</span>process track: <a href="/process#next">its own plan</a></p>
  <h1>Roadmap: Business Bench v2</h1>
  <p class="lede">A design programme for testing where current evaluation stops: unseen work, difficult decisions, evaluator validity and human completability. The 100-task catalogue and human-baseline protocol below are proposals; neither is a completed benchmark campaign. Rendered from <a href={base} rel="noopener">docs/v2</a> in the repository; disputes and suggestions are GitHub issues.</p>
  <h2 id="research-gates">What the next release must establish</h2>
  <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Open question</th><th>Needed evidence</th><th>Decision it enables</th></tr></thead><tbody>
    <tr><td>Do the tests accept valid work and reject plausible mistakes?</td><td>Blinded review of accepted and rejected artifacts, adjudication of disagreements, targeted invalid outputs.</td><td>Estimate evaluator error; revise the contract before confirmatory runs.</td></tr>
    <tr><td>Does performance transfer beyond exposed fixtures?</td><td>Separate held-out instances, held-out templates and a stated deployment sampling frame.</td><td>Identify the level of novelty the result supports.</td></tr>
    <tr><td>Which part of the system explains the difference?</td><td>A matched model/harness design with declared budgets, randomized order and contemporaneous runs.</td><td>Estimate component effects instead of attributing a bundled comparison.</td></tr>
    <tr><td>Is harder work both realistic and completable?</td><td>Practitioner specification review, human completion records and measured difficulty bands.</td><td>Distinguish substantive difficulty from ambiguity or volume alone.</td></tr>
  </tbody></table></div>
  <p>Implementation state and completed validation are tracked in <a href={`${REPO}/blob/main/STATUS.md`} rel="noopener">STATUS.md</a>; evidence requirements and planned work in <a href={`${REPO}/blob/main/GOALS.md`} rel="noopener">GOALS.md</a>. The <a href="/process#next">process track</a> has a separate sequence because its runner and outcome measures differ.</p>
  <nav slot="contents" class="toc" aria-label="On this page"><span class="toc-h">On this page</span><a href="#research-gates">Research gates</a>{toc.map((t) => <a href={`#${t.id}`} class={`d${t.depth}`}>{t.text}</a>)}</nav>
  <article class="prose"><h2 id="specification">Specification</h2><div set:html={spec.html} /></article>
  <article class="prose" style="max-width:none"><h2 id="the-100-tasks">The 100 tasks</h2><div set:html={tasks.html} /></article>
  <article class="prose"><h2 id="human-baseline-protocol">Human baseline protocol</h2><div set:html={human.html} /></article>
</Base>
