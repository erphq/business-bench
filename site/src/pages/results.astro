---
import Base from "@/layouts/Base.astro";
import Bar from "@/components/Bar.astro";
import Reps from "@/components/Reps.astro";
import Figure from "@/components/Figure.astro";
import DotChart from "@/components/DotChart.astro";
import WorkloadComparison from "@/components/WorkloadComparison.astro";
import { ARMS, SUMMARY_BY_ID, CATEGORIES, CATEGORY_LABEL, deskTasks, attempts, matrix, provenance, prices, scorer, scorerDelta, intervals, deskComparison, deskCampaign, deskCampaignLabels, fmt, REPO } from "@/lib/data";
const desk = deskTasks(), led = attempts(), m = matrix(), prov = provenance(), price = prices(), sc = scorer();
const reps = prov.repetitions as number, total = ARMS.length * reps;
const passN = (t: string) => ARMS.reduce((n, a) => n + m[t][a.id].filter((r) => r.passed).length, 0);
const rawN = (t: string) => ARMS.reduce((n, a) => n + m[t][a.id].filter((r) => r.raw_passed).length, 0);
const noneTasks = desk.filter((t) => passN(t.id) === 0);
const allTasks = desk.filter((t) => passN(t.id) === total);
const delta = Object.fromEntries(ARMS.map((a) => [a.id, scorerDelta(a.id)]));
const failTypes = Object.fromEntries(ARMS.map((a) => {
  const c: Record<string, number> = {};
  for (const r of led) if (r.harness === a.id && !r.passed) for (const k of r.checks) if (k.required && !k.passed) c[k.type] = (c[k.type] ?? 0) + 1;
  return [a.id, Object.entries(c).sort((x, y) => y[1] - x[1]).slice(0, 3)];
}));
const bs = prov.paired_task_bootstrap;
const comparison = deskComparison();
const changedTask = (task: string) => ARMS.some((arm) => m[task][arm.id].some((row) => row.passed !== row.raw_passed || row.raw_grader_error_count > 0));
const sections = [["headline", "Complete comparison"], ["repetitions", "Repetitions"], ["categories", "Category results"], ["workload", "Explore workload weights"], ["scorer", "Evaluator changes"], ["execution", "Execution accounting"], ["resources", "Resource use"], ["matrix", "Per-task matrix"], ["provenance", "Provenance"]];
const eqSet = new Set(sc.equivalenceTasks);
const I = Object.fromEntries(ARMS.map((a) => [a.id, intervals(a.id)]));
const byRate = [...ARMS].sort((a, b) => SUMMARY_BY_ID[b.id].pass_rate - SUMMARY_BY_ID[a.id].pass_rate);
const [lead, other] = byRate;
const catRate = (arm: string, c: string) => { const b = SUMMARY_BY_ID[arm].by_category[c]; return b.passed / b.attempts; };
const pctx = (x: number, d = 1) => `${(x * 100).toFixed(d)}%`;
const catSizes = CATEGORIES.map((c) => desk.filter((t) => t.category === c.id).length).sort((a, b) => a - b);
const later = deskCampaignLabels().map(deskCampaign);
const desc = "Complete desk comparison of Business Bench: 1,122 attempts, two systems, one frozen scorer with raw verdicts retained, per-task matrix, resource use, and provenance.";
---
<Base title="Results" description={desc} path="/results">
  <p class="meta">File tasks<span class="sep">·</span>results from 16 September 2026</p>
  <h1>Results, 16 September 2026</h1>
  <p class="lede">Two AI agent setups each did all {desk.length} file tasks {reps} times, and every answer was checked with the same rules. Proto (built by ERP.AI) used DeepSeek V4.1 Flash; Codex (OpenAI) used GPT-5.6 sol. Because the models differ, this compares complete setups, not the agents alone.</p>

  <nav slot="contents" class="toc" aria-label="On this page"><span class="toc-h">On this page</span>{sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>
  <div class="callout">
    <span class="t">Keep in mind</span>
    <p>The two setups differ in model, agent and run dates, so this does not show which part made the difference. The final grading rules were fixed after the answers existed, by ERP.AI, which builds Proto; the original grades are kept alongside, and the <a href="#scorer">grading changes</a> section lists every answer whose verdict changed.</p>
  </div>

  {later.length > 0 && <div class="callout">
    <span class="t">Newer results</span>
    <p>{later.map((c, i) => <><a href={`/results/${c.label}`}>{c.title}</a>: Proto and Codex on the same model, plus Proto on DeepSeek, each doing every task {c.repetitions === 1 ? "once" : "three times"} ({[...c.arms].sort((a, b) => c.summary[b.id].passed - c.summary[a.id].passed).map((a) => `${a.system} ${c.summary[a.id].passed} of ${c.summary[a.id].attempts}`).join(", ")}){i < later.length - 1 ? "; " : "."}</>)}</p>
  </div>}

  <h2 id="headline">Frozen and raw scores</h2>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>System</th><th style="width:30%">Frozen pass rate</th><th class="n">Frozen / 561</th><th class="n">Raw / 561</th><th class="n">All {reps} / 187</th><th class="n">Median min</th><th class="n">p90 min</th><th class="n">Est. model cost / attempt (USD)</th></tr></thead>
    <tbody>{ARMS.map((a) => { const s = SUMMARY_BY_ID[a.id]; return (
      <tr id={a.id}>
        <td><span class="sys"><i class={`swatch s-${a.slot}`}></i><span>{a.system}</span></span><div class="dim" style="font-size:12px;margin-left:20px">{a.harness} · {a.route}</div></td>
        <td><Bar value={s.pass_rate} series={a.slot} digits={2} /></td>
        <td class="n">{s.passed}</td><td class="n">{s.raw_passed}</td><td class="n">{s.all_three_pass}</td>
        <td class="n">{(s.median_wall_s / 60).toFixed(2)}</td><td class="n">{(s.p90_wall_s / 60).toFixed(2)}</td><td class="n">{s.estimated_cost_mean_usd.toFixed(4)}</td>
      </tr>); })}</tbody>
  </table></div>
  <p class="muted">The lead is {bs.difference_percentage_points.toFixed(2)} percentage points under the frozen scorer. A paired, task-clustered bootstrap ({fmt.int(bs.samples)} resamples, seed {bs.seed}, each task's {reps} repetitions kept together) gives a descriptive 95% interval of +{bs.bootstrap_95_percent_interval_pp[0].toFixed(2)} to +{bs.bootstrap_95_percent_interval_pp[1].toFixed(2)} points. Task identifiers, rather than task families, are resampled. The interval does not account for related families, scorer selection, development exposure, or a different workload.</p>

  <Figure n={1} id="figure-intervals">
    <DotChart
      label={`Attempt acceptance and all-${reps} acceptance per system with task-bootstrap intervals; at-least-one acceptance uses hindsight.`}
      domain={[0.6, 1]} ticks={[0.6, 0.7, 0.8, 0.9, 1]}
      keys={[{ label: "attempt acceptance", shape: "" }, { label: `all ${reps} accepted`, shape: "ring" }, { label: "at least one accepted", shape: "sq" }]}
      rows={byRate.map((a) => ({ label: a.system, sub: a.harness, slot: a.slot, link: true,
        points: [
          { value: I[a.id].pass1.value, lo: I[a.id].pass1.ci[0], hi: I[a.id].pass1.ci[1], title: `pass@1 ${pctx(I[a.id].pass1.value)}` },
          { value: I[a.id].passAll.value, lo: I[a.id].passAll.ci[0], hi: I[a.id].passAll.ci[1], shape: "ring", title: `pass^${reps} ${pctx(I[a.id].passAll.value)}` },
          { value: I[a.id].passAny.value, shape: "sq", title: `pass@${reps} ${pctx(I[a.id].passAny.value)}` },
        ],
        valueText: pctx(I[a.id].pass1.value), valueSub: `[${pctx(I[a.id].pass1.ci[0])}, ${pctx(I[a.id].pass1.ci[1])}]` }))}
    />
    <Fragment slot="caption">Attempt pass rate (pass@1, filled), share of tasks passed in all {reps} repetitions (pass^{reps}, open) and in at least one (pass@{reps}, square). Whiskers: 95% percentile intervals from 20,000 bootstrap resamples of the {desk.length} tasks, repetitions kept together; the value column gives the pass@1 interval. All-three acceptance describes repeated execution of fixed inputs; at-least-one acceptance assumes hindsight selection using the grader. Neither is a deployment success probability. See <a href="/analysis#reliability">repeated outcomes</a>.</Fragment>
  </Figure>

  <h2 id="repetitions">By repetition</h2>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>System</th>{Array.from({ length: reps }, (_, i) => <th class="n">Rep {i + 1} frozen</th>)}{Array.from({ length: reps }, (_, i) => <th class="n">Rep {i + 1} raw</th>)}</tr></thead>
    <tbody>{ARMS.map((a) => { const s = SUMMARY_BY_ID[a.id]; return (
      <tr><td><span class="sys"><i class={`swatch s-${a.slot}`}></i>{a.system}</span></td>
        {Array.from({ length: reps }, (_, i) => <td class="n">{s.by_repetition[String(i + 1)]} / 187</td>)}
        {Array.from({ length: reps }, (_, i) => <td class="n">{s.raw_by_repetition[String(i + 1)]} / 187</td>)}</tr>); })}</tbody>
  </table></div>
  <p class="muted">The same supplied inputs are used in each repetition. Repetition identifiers are bookkeeping labels, not matched random seeds or simultaneous trials. Variation here measures execution repeatability; new fixture instances and held-out templates require separate experiments.</p>

  <h2 id="categories">By category</h2>
  <Figure n={2} id="figure-categories">
    <DotChart
      label="Frozen attempt pass rate by task category for each system."
      domain={[0.4, 1]} ticks={[0.4, 0.5, 0.6, 0.7, 0.8, 0.9, 1]}
      keys={byRate.map((a) => ({ label: a.system, slot: a.slot }))}
      rows={CATEGORIES.map((c) => ({ label: c.label, sub: `${desk.filter((t) => t.category === c.id).length} tasks`, link: true,
        points: byRate.map((a) => ({ value: catRate(a.id, c.id), slot: a.slot, title: `${a.short} ${pctx(catRate(a.id, c.id))}` })),
        valueText: `${((catRate(lead.id, c.id) - catRate(other.id, c.id)) * 100 >= 0 ? "+" : "−")}${Math.abs((catRate(lead.id, c.id) - catRate(other.id, c.id)) * 100).toFixed(1)} pp`,
        valueSub: `${lead.short} − ${other.short}` }))}
    />
    <Fragment slot="caption">Frozen attempt pass rate per category ({reps} repetitions of each task). The value column is the difference between the two systems in percentage points. Categories hold {catSizes[0]} to {catSizes[catSizes.length - 1]} tasks, and one attempt changes a category rate by {(100 / (catSizes[0] * reps)).toFixed(2)} points in the smallest category versus {(100 / (catSizes[catSizes.length - 1] * reps)).toFixed(2)} in the largest. A task changing all {reps} repetitions has {reps} times that effect.</Fragment>
  </Figure>
  <details><summary>Counts by category</summary>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>Category</th><th class="n">Attempts</th>{ARMS.map((a) => <th class="n"><span class="sys" style="justify-content:flex-end"><i class={`swatch s-${a.slot}`}></i>{a.short}</span></th>)}</tr></thead>
    <tbody>{CATEGORIES.map((c) => (
      <tr>
        <td><a href={`/tasks#${c.id}`}>{c.label}</a></td><td class="n">{desk.filter((t) => t.category === c.id).length * reps}</td>
        {ARMS.map((a) => { const b = SUMMARY_BY_ID[a.id].by_category[c.id]; return <td class="n">{b.passed} / {b.attempts}</td>; })}
      </tr>))}</tbody>
  </table></div>
  </details>

  <h2 id="workload">How category weights change the comparison</h2>
  <p>The published mix weights categories by task counts. Equal category weights change the Proto-minus-Codex gap from {(comparison.frozenDifference * 100).toFixed(2)} to {(comparison.equalCategories.difference * 100).toFixed(2)} percentage points. The control below changes weights without rerunning an agent or changing a verdict.</p>
  <WorkloadComparison />

  <h2 id="scorer">What the frozen scorer changed</h2>
  <p>The runner recorded original verdicts at execution time. The shared <code>conservative-v7</code> package then evaluated retained outputs; its source is released at <a href={`${REPO}/tree/main/${sc.dir}`} rel="noopener">{sc.dir}</a>. It includes native workbook recalculation and declared equivalence rules for {sc.equivalenceTasks.length} tasks. These are evaluator changes on the same artifacts, not improvements from rerunning or repairing an agent's work.</p>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>System</th><th class="n">Pass → pass</th><th class="n">Fail → pass</th><th class="n">Ungraded → pass</th><th class="n">Pass → fail</th><th class="n">Fail → fail</th><th class="n">Ungraded → fail</th><th class="n">Net pass change</th></tr></thead>
    <tbody>{ARMS.map((a) => { const d = delta[a.id]; return <tr><td>{a.system}</td><td class="n">{d.passToPass}</td><td class="n">{d.failToPass}</td><td class="n">{d.ungradedToPass}</td><td class="n">{d.passToFail}</td><td class="n">{d.failToFail}</td><td class="n">{d.ungradedToFail}</td><td class="n">{d.net >= 0 ? "+" : ""}{d.net}</td></tr>; })}</tbody>
  </table></div>
  <p>The original gap is {(comparison.rawDifference * 100).toFixed(2)} points and the frozen gap is {(comparison.frozenDifference * 100).toFixed(2)}: a {(comparison.scorerSensitivity * 100).toFixed(2)}-point change in the measured comparison. Ungraded attempts remain in the full original denominator without being relabeled as ordinary agent failures. Each transition row accounts for all {reps * desk.length} attempts.</p>
  <p>The scorer was authored after outputs existed. A shared rule makes the primary scores comparable under that rule; its hash makes later changes detectable. Neither establishes that revisions were independent of the outputs or that every revised judgment is correct. The public ledger supports arithmetic verification, while independent artifact adjudication requires access to retained outputs that remain private.</p>
  <details><summary>Equivalence tasks and scorer identity</summary>
    <p>{sc.equivalenceTasks.map((task, index) => <><a href={`/tasks/${task}`}><code>{task}</code></a>{index < sc.equivalenceTasks.length - 1 ? ", " : ""}</>)}.</p>
    <p>Scorer manifest: <code class="mono" style="word-break:break-all">{sc.manifestSha}</code>. Every frozen receipt in this release points to this manifest. Verdicts are recorded as <code>raw_passed</code> and <code>passed</code>; <code>raw_grader_error_count</code> distinguishes ungraded originals.</p>
  </details>

  <h2 id="execution">Execution accounting</h2>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>System</th><th class="n">Timed out</th><th class="n">Nonzero exit</th><th class="n">Passing, abnormal exit</th><th class="n">Raw grader errors</th><th class="n">Frozen grader errors</th><th class="n">Missing usage</th></tr></thead>
    <tbody>{ARMS.map((a) => { const s = SUMMARY_BY_ID[a.id]; return (
      <tr><td><span class="sys"><i class={`swatch s-${a.slot}`}></i>{a.system}</span></td>
        <td class="n">{s.timed_out}</td><td class="n">{s.nonzero_exit}</td><td class="n">{s.passing_abnormal_exit}</td><td class="n">{s.raw_grader_error_attempts}</td><td class="n">{s.grader_error_attempts}</td><td class="n">{s.usage_missing}</td></tr>); })}</tbody>
  </table></div>
  <p class="muted">Every frozen pass also completed normally. The desk budget was 1,200 seconds per attempt.</p>

  <h3>Most-failed required check types</h3>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>System</th><th>Failed check types among frozen failures (count)</th></tr></thead>
    <tbody>{ARMS.map((a) => <tr><td><span class="sys"><i class={`swatch s-${a.slot}`}></i>{a.system}</span></td><td>{failTypes[a.id].map(([k, n]) => <span class="pill" style="margin-right:6px"><code>{k}</code> {n}</span>)}</td></tr>)}</tbody>
  </table></div>

  <h2 id="resources">Resource use</h2>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>System</th><th class="n">Input tokens</th><th class="n">Cached input</th><th class="n">Uncached input</th><th class="n">Output tokens</th><th class="n">Est. cost, sum USD</th><th class="n">Summed task time (h)</th><th>Price basis, USD / 1M (in / cached / out)</th></tr></thead>
    <tbody>{ARMS.map((a) => { const s = SUMMARY_BY_ID[a.id]; const p = price[a.model] ?? price["openai/" + a.model]; return (
      <tr><td><span class="sys"><i class={`swatch s-${a.slot}`}></i>{a.system}</span></td><td class="n">{fmt.m(s.usage.input)}</td><td class="n">{fmt.m(s.usage.cached_input)}</td><td class="n">{fmt.m(s.usage.uncached_input)}</td><td class="n">{fmt.m(s.usage.output)}</td><td class="n">{s.estimated_cost_sum_usd.toFixed(2)}</td><td class="n">{(s.sum_wall_s / 3600).toFixed(1)}</td><td class="mono">{p ? `${p.input} / ${p.cached_input} / ${p.output}` : "n/a"}</td></tr>); })}</tbody>
  </table></div>
  <p class="muted">Costs are estimates from captured usage and the list prices in <a href={`${REPO}/blob/main/bench/prices.json`} rel="noopener">bench/prices.json</a>. Codex ran through a subscription and is priced at API list price. Proto has lower estimated model spending, more input and output tokens, and a worse p90 duration. These are different resource dimensions. Summed durations measure occupied task time, not elapsed campaign time under concurrency.</p>

  <p class="muted">Costs exclude infrastructure, human review, repair, and uncaptured usage. Proto records 16,954 completed model responses and nine request starts without completed responses; Codex exposes 561 task-level usage aggregates rather than comparable request counts. See <a href="/analysis#cost">spending per accepted attempt</a> for the campaign accounting ratio.</p>

  <h2 id="matrix">Per-task matrix</h2>
  <p class="muted">{reps} squares per cell, one per repetition. Green is a frozen pass; a green square with a hollow centre passed under the frozen scorer but was originally failed or ungraded; grey is a fail; a hollow grey centre is a timeout. {noneTasks.length === 1 ? "One task" : `${noneTasks.length} tasks`} passed nowhere; {allTasks.length} passed everywhere.</p>
  <div class="legend"><span><i class="rep p"></i> pass</span><span><i class="rep p eq"></i> pass, frozen scorer only</span><span><i class="rep f"></i> fail</span><span><i class="rep f t"></i> fail, timed out</span></div>
  <div class="filters" role="group" aria-label="Filter by category" data-filter="matrix">
    <button aria-pressed="true" data-cat="all">All {desk.length}</button>
    {CATEGORIES.map((c) => <button aria-pressed="false" data-cat={c.id}>{c.label} {desk.filter((t) => t.category === c.id).length}</button>)}
    <button aria-pressed="false" data-cat="flip">Changed verdict {desk.filter((t) => changedTask(t.id)).length}</button>
    <button aria-pressed="false" data-cat="eq">Equivalence tasks {sc.equivalenceTasks.length}</button>
  </div>
  <div class="tbl-wrap"><table class="tbl" id="matrix-table">
    <thead><tr><th>Task</th><th>Category</th>{ARMS.map((a) => <th><span class="sys"><i class={`swatch s-${a.slot}`}></i>{a.system}</span></th>)}<th class="n">Frozen / {total}</th><th class="n">Raw / {total}</th></tr></thead>
    <tbody>{desk.map((t) => (
      <tr data-cat={t.category} data-flip={changedTask(t.id) ? "1" : "0"} data-eq={eqSet.has(t.id) ? "1" : "0"}>
        <td><a href={`/tasks/${t.id}`}>{t.title}</a><div class="dim mono" style="font-size:12px">{t.id}</div></td>
        <td class="muted">{CATEGORY_LABEL[t.category]}</td>
        {ARMS.map((a) => <td><Reps runs={m[t.id][a.id]} /></td>)}
        <td class="n">{passN(t.id)}</td><td class="n">{rawN(t.id)}</td>
      </tr>))}</tbody>
  </table></div>

  <h2 id="provenance">Provenance</h2>
  <div class="tbl-wrap"><table class="tbl">
    <tbody>
      <tr><td>Campaign</td><td><code>{prov.campaign}</code></td></tr>
      <tr><td>Ledger SHA-256</td><td class="mono" style="word-break:break-all">{prov.ledger_sha256}</td></tr>
      <tr><td>Scorer manifest SHA-256</td><td class="mono" style="word-break:break-all">{prov.scorer_manifest_sha256}</td></tr>
      <tr><td>Original scorecard SHA-256</td><td class="mono" style="word-break:break-all">{prov.original_scorecard_sha256}</td></tr>
      {ARMS.map((a) => { const c = prov.configurations[a.id]; return <tr><td>Configuration: {a.short}</td><td>{Object.entries(c).map(([k, v]) => <span class="pill" style="margin:0 6px 4px 0">{k}: {String(v)}</span>)}</td></tr>; })}
      {ARMS.map((a) => <tr><td>Source cohorts: {a.short}</td><td class="mono" style="font-size:13px">{(prov.source_cohorts[a.id] as string[]).join("; ")}</td></tr>)}
      <tr><td>Evidence verification</td><td>{prov.evidence_verification}</td></tr>
      <tr><td>Scorer note</td><td>{prov.scorer_note}</td></tr>
      <tr><td>Cost note</td><td>{prov.cost_note}</td></tr>
      <tr><td>Limitations</td><td>{prov.limitations}</td></tr>
      <tr><td>Build track</td><td>{prov.build_status}</td></tr>
      <tr><td>Excluded</td><td>{prov.exclusions}</td></tr>
    </tbody>
  </table></div>
  <p>Verify the released data with <code>python bench/export_campaign.py --verify</code>, which checks matrix completeness, score arithmetic, the ledger hash, and every file in the frozen scorer package against <a href={`${REPO}/blob/main/results/latest/attempts.jsonl`} rel="noopener">results/latest/attempts.jsonl</a>. It does not re-grade the original artifacts, which remain private; their hashes are in the ledger.</p>

  <script>
    for (const group of document.querySelectorAll<HTMLElement>("[data-filter]")) {
      const table = document.getElementById(group.dataset.filter + "-table");
      group.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest("button"); if (!b || !table) return;
        for (const x of group.querySelectorAll("button")) x.setAttribute("aria-pressed", String(x === b));
        const cat = b.dataset.cat;
        for (const tr of table.querySelectorAll<HTMLElement>("tbody tr")) {
          const show = cat === "all" || (cat === "flip" ? tr.dataset.flip === "1" : cat === "eq" ? tr.dataset.eq === "1" : tr.dataset.cat === cat);
          tr.style.display = show ? "" : "none";
        }
      });
    }
  </script>
</Base>
