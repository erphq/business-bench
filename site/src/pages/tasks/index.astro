---
import Base from "@/layouts/Base.astro";
import { ARMS, CATEGORIES, deskTasks, buildTasks, processTasks, FAMILY_LABEL, matrix, REPO } from "@/lib/data";
const desk = deskTasks(), build = buildTasks(), proc = processTasks(), m = matrix();
const total = ARMS.length * 3;
const passN = (t: string) => ARMS.reduce((n, a) => n + m[t][a.id].filter((r) => r.passed).length, 0);
const desc = "Every Business Bench task: 187 desk tasks with recorded pass counts, 20 application-build tasks, and the six process-track pilot tasks run inside an ERP.";
---
<Base title="Tasks" description={desc} path="/tasks">
  <p class="meta">Task inventory<span class="sep">·</span>{desk.length} desk<span class="sep">·</span>{build.length} build<span class="sep">·</span>{proc.length} process (pilot)</p>
  <h1>Tasks</h1>
  <p class="lede">Every task is public in the repository with its generator, inputs, checks and reference solution. Requests are written the way the person asking would write them, and the input files are messy on purpose. These pages leave out author notes and planted traps; the repository has them.</p>
  <div class="callout"><p>The task set is exposed: anything public can end up in training data. Each generator takes a seed, so a re-rolled variant with different names and amounts can be produced for a private evaluation. See the <a href="/audit#contamination">contamination note</a>.</p></div>

  <h2 id="desk">Desk track</h2>
  <p class="muted">"Passes" counts frozen-scorer passes across {ARMS.length} systems × three repetitions in the complete desk comparison.</p>
  {CATEGORIES.map((c) => { const rows = desk.filter((t) => t.category === c.id); return (
    <section>
      <h3 id={c.id}>{c.label} <span class="dim" style="font-weight:400">· {rows.length} tasks · {c.deliverable.toLowerCase()}</span></h3>
      <div class="tbl-wrap"><table class="tbl">
        <thead><tr><th style="width:44%">Task</th><th>Deliverables</th><th class="n">Checks</th><th class="n">Passes / {total}</th></tr></thead>
        <tbody>{rows.map((t) => (
          <tr><td><a href={`/tasks/${t.id}`}>{t.title}</a><div class="dim mono" style="font-size:12px">{t.id}</div></td>
            <td class="mono" style="font-size:13px">{t.deliverables.join(", ")}</td>
            <td class="n">{t.checks.length}</td><td class="n">{passN(t.id)}</td></tr>))}</tbody>
      </table></div>
    </section>); })}

  <h2 id="build">Build track</h2>
  <p class="muted">Each pack: an owner's requirement, seed CSV exports to import, a binary acceptance checklist that opens with the 14-item <a href="/methods#build-baseline">enterprise baseline</a>, and three change requests. No build scores are published; the packs are released and validated.</p>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th style="width:44%">Application</th><th>Seed files</th><th class="n">Checklist items</th><th class="n">Change items</th></tr></thead>
    <tbody>{build.map((b) => (
      <tr><td><a href={`/build/${b.id}`}>{b.title}</a><div class="dim mono" style="font-size:12px">{b.id}</div></td>
        <td class="mono" style="font-size:13px">{b.seed.join(", ")}</td>
        <td class="n">{b.checklistItems}</td><td class="n">{b.changes.reduce((n, c) => n + c.items, 0)}</td></tr>))}</tbody>
  </table></div>
  <h2 id="process">Process track</h2>
  <p class="muted">Pilot tasks in which the agent works inside an ERP over several business days and is graded on the final system state and the audit log. A provisional pilot campaign is published on the <a href="/process#campaign">process track</a> page.</p>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th style="width:44%">Task</th><th>Role</th><th>Family</th><th class="n">Turns</th><th class="n">Checks</th></tr></thead>
    <tbody>{proc.map((t) => (
      <tr><td><a href={`/process/${t.id}`}>{t.title}</a><div class="dim mono" style="font-size:12px">{t.id}</div></td>
        <td>{t.agent.title}</td><td class="muted">{FAMILY_LABEL[t.family] ?? t.family}</td><td class="n">{t.turns.length}</td><td class="n">{t.checks.length}</td></tr>))}</tbody>
  </table></div>

  <p>Task format and authoring rules: <a href={`${REPO}/blob/main/docs/task-format.md`} rel="noopener">docs/task-format.md</a>, <a href={`${REPO}/blob/main/docs/authoring-guide.md`} rel="noopener">desk authoring guide</a>, <a href={`${REPO}/blob/main/docs/authoring-guide-build.md`} rel="noopener">build authoring guide</a>.</p>
</Base>
