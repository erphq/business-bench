---
import Base from "@/layouts/Base.astro";
import { buildTasks, REPO, type BuildTask } from "@/lib/data";
export async function getStaticPaths() { return buildTasks().map((t) => ({ params: { id: t.id }, props: { task: t } })); }
const { task } = Astro.props as { task: BuildTask };
const desc = `${task.title}. A build-track task from Business Bench with seed data, a ${task.checklistItems}-item acceptance checklist, and three change requests.`;
---
<Base title={task.title} description={desc} path={`/build/${task.id}`}>
  <p class="kicker"><a href="/tasks">Tasks</a> · <a href="/tasks#build">build</a> · {task.category}</p>
  <h1>{task.title}</h1>
  <p class="muted mono" style="margin-top:8px">{task.id} · {task.timeout_per_turn_s} s per turn · <a href={`${REPO}/tree/main/tasks/build/${task.id}`} rel="noopener">source</a></p>

  <h2>The ask</h2>
  <blockquote class="ask">{task.ask}</blockquote>
  <p class="muted">Seed files the agent must import: <code>{task.seed.join("</code>, <code>")}</code>. The agent must leave a <code>RESULT.json</code> with a reachable URL, an admin login, and the named restricted login.</p>

  <h2>Acceptance checklist</h2>
  <p>{task.checklistItems} binary items. The first 14 are the <a href="/methods#build-baseline">enterprise baseline</a> shared by every build task (delivery, invitations, roles, server-side authorization, scoped live dashboard, exact lists and exports, audit metadata, validation, persistence); the rest are application-specific. Core items, which together define "first usable": {task.coreItems.join(", ")}.</p>
  <div class="tbl-wrap"><table class="tbl" style="max-width:480px">
    <thead><tr><th>Tag</th><th class="n">Items</th></tr></thead>
    <tbody>{Object.entries(task.tags).sort((a, b) => b[1] - a[1]).map(([k, n]) => <tr><td>{k}</td><td class="n">{n}</td></tr>)}</tbody>
  </table></div>
  <p class="muted">The full checklist with per-item "how to check" instructions and expected figures is in <a href={`${REPO}/blob/main/tasks/build/${task.id}/checklist.md`} rel="noopener">checklist.md</a>. Testers see it; the agent never does.</p>

  <h2>Change requests</h2>
  <p class="muted">Each change is a new one-shot turn on the carried-forward workspace. Only the owner's text below is sent; the tester items are withheld. After each change the full checklist is rerun, so regressions count.</p>
  {task.changes.map((c) => (
    <section>
      <h3>Change {c.n} <span class="dim" style="font-weight:400">· {c.items} new checklist items</span></h3>
      <blockquote class="ask" style="font-size:17px">{c.ask}</blockquote>
    </section>))}

  <div class="callout warn"><p><strong>No published score.</strong> Build runs need a human acceptance pass on a live URL, and no arm has completed one for the full set. Automated probes generate a tester sheet; they do not substitute for it. Results will be published as a separately labeled release when an arm completes.</p></div>
</Base>
