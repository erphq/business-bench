---
import Base from "@/layouts/Base.astro";
import { readRepoFile, REPO, SITE, ORG, AUTHORS } from "@/lib/data";
import { renderMarkdown } from "@/lib/markdown";
import PaperFigure from "@/components/PaperFigure.astro";
import "katex/dist/katex.min.css";
const { html, toc } = renderMarkdown(readRepoFile("SPEC.md"), { stripFirstH1: true, linkBase: `${REPO}/blob/main/`, math: true });
const sections = html.split("<!-- headline-figure -->");
if (sections.length !== 2) throw new Error("The paper must contain exactly one headline-figure marker.");
const desc = "Business Bench: Evaluating Agents on Business Deliverables. The full paper: design, evaluation protocol, frozen scoring, results, resource use, validity, and how to run and audit the benchmark.";
---
<Base title="Paper" description={desc} path="/paper" ogType="article" jsonld={[{
  "@context": "https://schema.org", "@type": "ScholarlyArticle", headline: "Business Bench: Evaluating Agents on Business Deliverables",
  author: AUTHORS.map((a) => ({ "@type": "Person", name: a })), publisher: { "@type": "Organization", name: ORG.name, url: ORG.url },
  datePublished: "2026-09", dateModified: "2026-09-27", url: SITE + "/paper", isAccessibleForFree: true, license: `${REPO}/blob/main/LICENSE`,
  about: ["AI agents", "benchmarks", "evaluation", "business work"],
}]}>
  <p class="meta">Paper<span class="sep">·</span>Revised 27 September 2026</p>
  <h1>Business Bench: Evaluating Agents on Business Deliverables</h1>
  <p class="muted" style="margin-top:8px">Somesh Misra, Somnath Misra, Shashank Dixit · ERP AI Research · September 2026</p>
  <p class="lede">The full manuscript: the measurement framework, benchmark construction, evaluation protocol, results, and limits of the evidence. Figures and result tables describe the released desk comparison; the appendices document execution and audit procedures.</p>
  <div class="article-links">
    <a href={`${REPO}/blob/main/docs/business-harness-bench-spec.pdf`} rel="noopener">PDF</a>
    <a href={`${REPO}/blob/main/SPEC.md`} rel="noopener">Markdown source</a>
  </div>
  <nav slot="contents" class="toc" aria-label="On this page"><span class="toc-h">On this page</span>{toc.map((t) => <a href={`#${t.id}`} class={`d${t.depth}`}>{t.text}</a>)}</nav>
  <article class="prose paper-body">
    <Fragment set:html={sections[0]} />
    <PaperFigure />
    <Fragment set:html={sections[1]} />
  </article>
</Base>

<style>
  .paper-body :global(.katex) { font-size: 1.08em; }
  .paper-body :global(.katex-display) { overflow-x: auto; overflow-y: hidden; padding: 4px 0 8px; margin: 24px 0; }
  .paper-body :global(.katex-display > .katex) { width: max-content; min-width: 100%; }
</style>
