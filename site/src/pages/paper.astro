---
import Base from "@/layouts/Base.astro";
import { readRepoFile, REPO } from "@/lib/data";
import { renderMarkdown } from "@/lib/markdown";
const { html, toc } = renderMarkdown(readRepoFile("SPEC.md"), { stripFirstH1: true, linkBase: `${REPO}/blob/main/` });
const desc = "Business Harness Bench: Measuring Reliable Completion of Business Work. The full specification: premise, protocol, grading, validity boundary, reproduction, and the full-1 results.";
---
<Base title="Paper" description={desc} path="/paper">
  <p class="kicker">Specification · v1.0.0</p>
  <h1>Business Harness Bench: Measuring Reliable Completion of Business Work</h1>
  <p class="lede">The complete specification as released in the repository. Sections 1 to 6 are the research premise; 7 to 11 the technical specification; 12 the recorded results of campaign full-1.</p>
  <div class="actions">
    <a class="btn" href={`${REPO}/blob/main/docs/business-harness-bench-spec.pdf`} rel="noopener">PDF</a>
    <a class="btn" href={`${REPO}/blob/main/SPEC.md`} rel="noopener">Markdown source</a>
  </div>
  <div class="two">
    <nav class="toc" aria-label="Contents">{toc.map((t) => <a href={`#${t.id}`} class={`d${t.depth}`}>{t.text}</a>)}</nav>
    <article class="prose" set:html={html} />
  </div>
</Base>
