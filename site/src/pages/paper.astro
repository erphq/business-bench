---
import Base from "@/layouts/Base.astro";
import { readRepoFile, REPO } from "@/lib/data";
import { renderMarkdown } from "@/lib/markdown";
const { html, toc } = renderMarkdown(readRepoFile("SPEC.md"), { stripFirstH1: true, linkBase: `${REPO}/blob/main/` });
const desc = "Business Bench: Evaluating Agents on Business Deliverables. The full paper: design, evaluation protocol, frozen scoring, results, resource use, validity, and how to run and audit the benchmark.";
---
<Base title="Paper" description={desc} path="/paper">
  <p class="kicker">Paper and specification · v1.1.0</p>
  <h1>Business Bench: Evaluating Agents on Business Deliverables</h1>
  <p class="muted" style="margin-top:8px">Somesh Misra, Somnath Misra, Shashank Dixit · ERP AI Research · September 2026</p>
  <p class="lede">The paper as released in the repository. Sections 1 to 6 are the argument, design, protocol, results, resource use, and limitations; Appendix A covers running, scoring, and release validation. Result tables are the recorded numbers of the current release.</p>
  <div class="actions">
    <a class="btn" href={`${REPO}/blob/main/docs/business-harness-bench-spec.pdf`} rel="noopener">PDF</a>
    <a class="btn" href={`${REPO}/blob/main/SPEC.md`} rel="noopener">Markdown source</a>
  </div>
  <div class="two">
    <nav class="toc" aria-label="Contents">{toc.map((t) => <a href={`#${t.id}`} class={`d${t.depth}`}>{t.text}</a>)}</nav>
    <article class="prose" set:html={html} />
  </div>
</Base>
