{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "businessbench-site",
  "account_id": "7293d7f2cac4aa6f0d262f49508faf2e",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "businessbench.org", "custom_domain": true },
    { "pattern": "www.businessbench.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
